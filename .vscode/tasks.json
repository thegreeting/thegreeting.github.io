{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "serve",
      "command": "python",
      "type": "shell",
      "args": [
        "-m",
        "http.server",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "static-server",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Serving HTTP on",
          "endsPattern": "KeyboardInterrupt"
        }
      },
      "group": "build"
    }
  ]
}
